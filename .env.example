# ============================================================================
# .env.example — VORLAGE für lokale/serverseitige Umgebungsvariablen
# ----------------------------------------------------------------------------
# Diese Datei wird versioniert und enthält KEINE echten Werte — NUR Platzhalter
# (z. B. <wert>). Kopiere sie nach `.env.local` (gitignored) und trage echte Werte
# ein. Secrets gehören NIEMALS ins Repository.
# HINWEIS: gitleaks SCANNT diese Datei (nur die <…>-Platzhalter sind allowlistet) — ein
# versehentlich eingetragener Live-Wert WIRD gefunden und blockiert Commit/CI (F-027).
#
# Validierung: src/server/config/env.ts (regulär) und src/server/config/tooling.ts
# (erhöhte Rechte). Fehlt/ungültig eine Variable, schlägt der erste Zugriff fehl.
# ============================================================================
#
# LOKALE ENTWICKLUNG (Phase C-lokal): Lege eine GITIGNORED `.env.development.local`
# an (Next lädt sie im Dev automatisch; Scripts via `node --env-file=...`). Werte
# dort sind LOKAL und NICHT geheim. Beispiel (PLATZHALTER — eigenes Dev-Passwort wählen):
#   DATABASE_URL=postgres://app_user:<lokales-dev-passwort>@localhost:5432/fahrschul_dev
#   TOOLING_DATABASE_URL=postgres://<lokaler-migrator>@localhost:5432/fahrschul_dev
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Danach: `npm run db:setup` (Migration + app_user-Login + Seed) und `npm run db:smoke`.
# Details: db/RUNBOOK.md, Abschnitt 0.

# ---- Regulärer App-Pfad (DB-Rolle app_user, RLS-pflichtig, KEIN BYPASSRLS) ----
# Format: postgres://app_user:<passwort>@<host>:<port>/<db>
DATABASE_URL=
# DB-TLS (fail-closed): disable | require | verify-full. Leer = Default:
# Produktion 'require' (TLS-Zwang, kein Klartext), Dev/Test 'disable'. In Produktion
# ist 'disable' VERBOTEN (harter Abbruch). 'verify-full' = stärkste Stufe
# (Zertifikatsprüfung, MITM-Schutz); optional CA-PEM über DATABASE_SSL_CA.
# DATABASE_SSL=
# DATABASE_SSL_CA=

# ---- Supabase Auth (öffentliche, NICHT geheime Werte) ----
NEXT_PUBLIC_SUPABASE_URL=
# Neuer Publishable Key (ab 2025 empfohlen):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key (bis Ende 2026, wird als Fallback akzeptiert) — nur EINEN setzen:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Erhöhter Tooling-/Migrations-Pfad (NUR für Scripts/Wartung, protokolliert) ----
# Owner-/Migrations-Verbindung (umgeht RLS bewusst):
TOOLING_DATABASE_URL=
# Neuer Supabase Secret Key (SECRET! nur Tooling/Webhooks):
SUPABASE_SECRET_KEY=
# Legacy service_role key (bis Ende 2026, Fallback) — nur EINEN setzen:
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Seite / SEO ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Öffentlicher Pfadname des Content-Bereichs (noch nicht final):
NEXT_PUBLIC_CONTENT_SLUG=ratgeber

# ---- Karten-Tiles ----
# Produktion: eigenen/bezahlten Tile-Anbieter setzen (OSMF-Public-Tiles sind kein
# Produktionsdienst). Ohne diese Variable nutzt der Adapter nur einen DEV-Fallback.
# NEXT_PUBLIC_MAP_TILE_URL=https://{anbieter}/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap-Mitwirkende © {Anbieter}

# ---- Später (Stripe-Vertiefung) — Platzhalter, in Phase 1 nicht genutzt ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
